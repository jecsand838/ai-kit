# Source this file before `tool-sdk/scripts/verify_strict_live.sh`.
#
# The strict target launches the caller-selected real stdio MCP server through
# its ordinary documented command. It never substitutes a repository-authored
# fixture, mock, recording, or scripted echo server. The example below uses
# the independently maintained MCP filesystem server; replace paths and the
# package launcher with an already installed/pinned command where required.

export TEST_TOOL_SDK_MCP_PROGRAM=npx
export TEST_TOOL_SDK_MCP_ARGS_JSON='["--yes","@modelcontextprotocol/server-filesystem@2026.7.10","/absolute/path/to/live-fixture"]'
export TEST_TOOL_SDK_MCP_ENV_JSON='{}'
export TEST_TOOL_SDK_MCP_TIMEOUT_SECS=30
# Prepare marker.txt independently with exactly the bytes tool-sdk-live-marker\n.
export TEST_TOOL_SDK_MCP_TOOL_NAME=live__read_text_file
export TEST_TOOL_SDK_MCP_TOOL_ARGUMENTS_JSON='{"path":"/absolute/path/to/live-fixture/marker.txt"}'
export TEST_TOOL_SDK_MCP_EXPECTED_RESULT_JSON='{"content":[{"type":"text","text":"tool-sdk-live-marker\n","metadata":null}],"structured_content":{"content":"tool-sdk-live-marker\n"},"is_error":false,"metadata":{}}'

# Provider credentials do not belong in tool-sdk. Provider-hosted declarations
# and provider request rendering are proven by provider-sdk.
