# Optional alternative-backend configuration for verify_strict_live.sh.
# The default invocation needs none of these variables and owns a temporary
# Lance dataset when TEST_LANCEDB_EMBEDDED_PATH is absent. Source this file only
# after setting disposable local paths/ports, then select --backend NAME or
# --all-backends. The verifier creates a fresh Compose project and never resets
# a caller's project. Only selected backend variables are required.

# --------------------------------------------------------------------
# LanceDB
# --------------------------------------------------------------------
# Replace `/absolute/path/to/ai-kit` with your local workspace root.
export TEST_LANCEDB_EMBEDDED_PATH=/absolute/path/to/ai-kit/target/storage-kit-strict/lancedb

# --------------------------------------------------------------------
# SurrealDB
# --------------------------------------------------------------------
export TEST_SURREALDB_ROCKSDB_PATH=/absolute/path/to/ai-kit/target/storage-kit-strict/surreal-rocksdb
export TEST_SURREALDB_SURREALKV_PATH=/absolute/path/to/ai-kit/target/storage-kit-strict/surreal-surrealkv

# Compose-backed remote modes. The bundled docker-compose.strict.yml pins
# SurrealDB v3.3.0 and postgres:18.6-alpine3.24 locally for the
# canonical strict-live gate.
export TEST_SURREALDB_REMOTE_PORT="${TEST_SURREALDB_REMOTE_PORT:-8000}"
export TEST_SURREALDB_REMOTE_WS="ws://127.0.0.1:${TEST_SURREALDB_REMOTE_PORT}"
# Base HTTP URL. The verify script checks unauthenticated `/ready`
# without namespace/database headers for completed startup and a fresh heartbeat.
export TEST_SURREALDB_REMOTE_HTTP="http://127.0.0.1:${TEST_SURREALDB_REMOTE_PORT}"
export TEST_SURREALDB_ROOT_USER=root
export TEST_SURREALDB_ROOT_PASS=secret
export TEST_SURREALDB_NS=test
export TEST_SURREALDB_DB=test

# --------------------------------------------------------------------
# StateStore
# --------------------------------------------------------------------
# Redb and SQLite/Turso use their real in-memory embedded engines in the local
# StateStore integration target. PostgreSQL uses the Compose-backed service.
# The strict PostgreSQL 18 service requires ICU support and CREATEDB permission
# for the isolated, automatically removed non-binary collation database case.
export TEST_POSTGRES_STATE_STORE_HOST=127.0.0.1
export TEST_POSTGRES_STATE_STORE_PORT="${TEST_POSTGRES_STATE_STORE_PORT:-15432}"
export TEST_POSTGRES_STATE_STORE_DB=storage_kit_state
export TEST_POSTGRES_STATE_STORE_USER=storage_kit
export TEST_POSTGRES_STATE_STORE_PASS=secret

# The verifier requires these exact 127.0.0.1 base URLs and matching Compose ports.
# The verifier runs the complete strict target in each selected feature lane.
# Embedded path values are caller-owned roots; each lane uses fresh child paths.
# An omitted COMPOSE_PROJECT_NAME gets an invocation-specific disposable name.
