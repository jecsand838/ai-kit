# Copy this file to `app-kit/strict-tests.env`, review the selected real model,
# and source it only through the crate-owned verifier:
#   bash app-kit/scripts/verify_strict_live.sh
#
# The verifier fails if the real OpenCode or Ollama service is unavailable.
# The tests create unique target/OS-temporary durable domains and never delete
# foreign service data.

APP_KIT_STRICT_WORKSPACE="$(pwd -P)"
# Use the exact OpenCode release selected by agents-kit/specs/SPECIFICATIONS.md:
#   npm install --global --prefix "$PWD/target/opencode-releases/v1.19.3" opencode-ai@1.19.3
export PATH="${APP_KIT_STRICT_WORKSPACE}/target/opencode-releases/v1.19.3/bin:${PATH}"
export CARGO_INCREMENTAL=0

# Real Ollama API and an installed tool-capable model. The daemon must provide
# at least 65,536 context for this exact model.
export TEST_CUSTOM_OLLAMA_URL="http://127.0.0.1:11434/api"
export TEST_OLLAMA_MODEL_OPENCODE_DEFAULT="gemma4:e4b-it-qat"

# Real reusable OpenCode endpoint used by the strict precheck. The live suites
# launch their own real child processes with unique ports and domains. Start
# this precheck server from the workspace root after sourcing this file:
#   mkdir -p "${OPENCODE_TEST_HOME}/xdg/config" \
#     "${OPENCODE_TEST_HOME}/xdg/data" \
#     "${OPENCODE_TEST_HOME}/xdg/cache" \
#     "${OPENCODE_TEST_HOME}/xdg/state" \
#     "$(dirname -- "${OPENCODE_DB}")"
#   (cd app-kit && opencode serve --hostname 127.0.0.1 --port 4097)
export TEST_OPENCODE_URL="http://127.0.0.1:4097"
export OPENCODE_TEST_HOME="${APP_KIT_STRICT_WORKSPACE}/target/app-kit-strict-live/opencode"
export XDG_CONFIG_HOME="${OPENCODE_TEST_HOME}/xdg/config"
export XDG_DATA_HOME="${OPENCODE_TEST_HOME}/xdg/data"
export XDG_CACHE_HOME="${OPENCODE_TEST_HOME}/xdg/cache"
export XDG_STATE_HOME="${OPENCODE_TEST_HOME}/xdg/state"
export OPENCODE_DB="${OPENCODE_TEST_HOME}/database/opencode.db"
export OPENCODE_AUTO_SHARE=false
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false

# This is configuration, not a credential. Keep sharing, plugins, MCP, and
# background agents disabled so the proof owns every external effect.
export OPENCODE_CONFIG_CONTENT='{
  "share": "disabled",
  "enabled_providers": ["ollama"],
  "plugin": [],
  "mcp": {},
  "model": "ollama/gemma4:e4b-it-qat",
  "small_model": "ollama/gemma4:e4b-it-qat",
  "agent": {
    "build": {
      "temperature": 0
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:e4b-it-qat": {
          "name": "gemma4:e4b-it-qat",
          "temperature": true,
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  }
}'

# StateStore and knowledge persistence use isolated embedded Lance directories.
# No database service or database credentials are required.
