
# Copy this file to `agent-sdk/strict-tests.env`, fill in any placeholders,
# and then:
#   source agent-sdk/strict-tests.env
#
# The caller shell must source `agent-sdk/strict-tests.env` before running
# the canonical completion gate:
#   bash agent-sdk/scripts/verify_strict_live.sh
#
# Direct `strict_live` cargo runs are for focused iteration after the local
# Codex/OpenCode services are already running.

# The strict suites always target the enclosing ai-kit repo root.
AGENT_SDK_STRICT_WORKSPACE="$(pwd -P)"
# Install the exact selected test tools into ignored, versioned prefixes:
#   npm install --global --prefix "$PWD/target/codex-releases/rust-v0.163.0" @openai/codex@0.163.0
#   npm install --global --prefix "$PWD/target/opencode-releases/v1.19.3" opencode-ai@1.19.3
# Precheck verifies both executable and server versions against SPECIFICATIONS.md.
export PATH="${AGENT_SDK_STRICT_WORKSPACE}/target/codex-releases/rust-v0.163.0/bin:${AGENT_SDK_STRICT_WORKSPACE}/target/opencode-releases/v1.19.3/bin:${PATH}"
# The all-feature gate has a large native dependency graph on this machine.
# Disable incremental artifacts so repeated phase closure stays within disk.
export CARGO_INCREMENTAL=0

# Codex App Server
# Seed only authentication into an otherwise empty ignored home. Do not copy
# global config, state databases, sessions, instructions, plugins, or skills:
#   mkdir -p "${TEST_CODEX_HOME}"
#   install -m 600 "/absolute/path/to/existing/codex/auth.json" \
#     "${TEST_CODEX_HOME}/auth.json"
# Start the Codex release selected by `agent-sdk/specs/SPECIFICATIONS.md` with:
#   env CODEX_HOME="${TEST_CODEX_HOME}" codex app-server \
#     --listen ws://127.0.0.1:4500 \
#     -c 'mcp_servers={}' \
#     -c 'features.apps=false' \
#     -c 'features.code_mode=false' \
#     -c 'features.code_mode_only=false' \
#     -c 'features.current_time_reminder.enabled=true' \
#     -c 'features.current_time_reminder.clock_source="external"'
# Do not set approval_policy="untrusted": the selected release rejects that
# public setting, while retaining internal project-trust approval behavior.
# The two release request tests launch their own real stdio Codex with this same
# isolated TEST_CODEX_HOME and process-local flags (no config-file writes):
#   -c 'features.write_stdin_approval=true'
#   -c 'features.default_mode_request_user_input=true'
#   -c 'approval_policy="on-request"' -c 'approvals_reviewer="user"'
# They also disable apps, MCP, and code mode as above. Their passive framing
# bridge observes exact callback correlation without synthesizing responses.
# Use the installed binary only when `codex --version` matches that selection.
# Otherwise install the matching stable package or invoke a release-verified
# package under `target/codex-releases/<selected-release>/bin/codex`; never
# validate against a different Codex version.
# Start this documented loopback service before declaring strict-live
# unavailable when the configured local endpoint is not already running.
export TEST_CODEX_HOME="${AGENT_SDK_STRICT_WORKSPACE}/target/agent-sdk-strict-live/codex"
export TEST_CODEX_WS_URL="ws://127.0.0.1:4500"
# Exact selectable Codex model slug. Every Codex generation case verifies it
# against model inventory and sends that selection; no default/first fallback.
export TEST_CODEX_MODEL_DEFAULT="gpt-6-luna"
# Required explicit selection, including when updating an older local env file.
# Choose an effort advertised by the exact model above; strict-live checks its
# model inventory membership. The runner does not supply an implicit default.
export TEST_CODEX_REASONING_EFFORT="high"

# OpenCode Server
# Start the release selected by `agent-sdk/specs/SPECIFICATIONS.md` from the
# agent-sdk directory after sourcing this file. Keep every OpenCode runtime
# path under the ignored target-backed root and create those directories first:
#   mkdir -p "${OPENCODE_TEST_HOME}" "${XDG_CONFIG_HOME}" \
#     "${XDG_DATA_HOME}" "${XDG_CACHE_HOME}" "${XDG_STATE_HOME}" \
#     "$(dirname -- "${OPENCODE_DB}")"
#   (cd agent-sdk && opencode serve --hostname 127.0.0.1 --port 4096)
# The precheck requires the exact selected health version, effective
# three-model overlay, `share == "disabled"`, disabled background subagents,
# isolated paths, and the pinned CLI version.
# Start this documented loopback service before declaring strict-live
# unavailable when the configured local endpoint is not already running.
export TEST_OPENCODE_URL="http://127.0.0.1:4096"

# Optional: only set these if you start OpenCode with server auth enabled.
# export TEST_OPENCODE_USERNAME="opencode"
# export TEST_OPENCODE_PASSWORD="your-password"

# Agent StateStore and managed knowledge use owned embedded Lance directories.
# No external storage service configuration is required.

# Required Gemini Custom proof.
export TEST_GEMINI_API_KEY="replace-me"
export TEST_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
export TEST_GEMINI_MODEL_DEFAULT="models/gemini-3.8-flash"
export TEST_GEMINI_SERVICE_TIER="standard"

# Required current-model Custom and isolated OpenCode cloud journeys.
# Credentials remain caller-owned; these tests never persist them in Agent state.
export TEST_OPENAI_API_KEY="replace-me"
export TEST_OPENAI_BASE_URL="https://api.openai.com/v1"
export TEST_ANTHROPIC_API_KEY="replace-me"
export TEST_ANTHROPIC_BASE_URL="https://api.anthropic.com"
export TEST_CUSTOM_OPENAI_MODEL="gpt-6-luna"
export TEST_CUSTOM_ANTHROPIC_MODEL="claude-sonnet-5-5"
# Bare model ID only; the cloud test adds the openai/ provider prefix.
export TEST_OPENCODE_CLOUD_MODEL="gpt-6-luna"
# The cloud case owns a separate isolated OpenCode process with only the exact
# OpenAI role enabled. The ordinary Ollama overlay below remains unchanged.

# Ollama and OpenCode strict roles. Start Ollama with at least the coding-agent
# context required by the suite, then install the configured role tags:
#   OLLAMA_CONTEXT_LENGTH=65536 ollama serve
#   ollama pull qwen3.5:9b-q4_K_M
#   ollama pull ministral-3:8b-instruct-2512-q4_K_M
#   ollama pull gemma4:e4b-it-qat
# The precheck fresh-loads each distinct role without a request-level context
# override, proves at least 65,536 daemon-default context and exact positive
# size_vram == size in the native /ps response (the CLI 100% GPU predicate),
# observes exact-role absence after each unload before loading again, and
# leaves the ordinary primary warm for the strict run. Unload acknowledgment
# and absence polling share 30 seconds; cold loading has a separate 360 seconds.
export TEST_CUSTOM_OLLAMA_URL="http://127.0.0.1:11434/api"
export TEST_OLLAMA_MODEL_OPENCODE_DEFAULT="gemma4:e4b-it-qat"
export TEST_OLLAMA_MODEL_OPENCODE_ALTERNATE="ministral-3:8b-instruct-2512-q4_K_M"
export TEST_OLLAMA_MODEL_OPENCODE_SHELL="qwen3.5:9b-q4_K_M"
export TEST_OLLAMA_MODEL_CUSTOM_DEFAULT="ministral-3:8b-instruct-2512-q4_K_M"

# Correctness assertions are unconditional for every configured model. The
# retired TEST_MODEL_CONFORMANCE_PROFILE must be unset; precheck rejects it.
# Role tags may be changed together with the exact three-model overlay below.
# OpenCode roles must stay pairwise distinct, have a 4096 output limit, and
# declare no options or exactly {"reasoningEffort":"none"}. Privacy, tool,
# context, and GPU-residency requirements remain active for every role.
# The alternate role proves configured inventory; generation uses the primary
# or shell role. Custom knowledge uses TEST_OLLAMA_MODEL_CUSTOM_DEFAULT.

# Strict OpenCode isolation and the exact three-model provider overlay. The
# tracked `agent-sdk/opencode.json` intentionally remains privacy-only.
# Every reusable-server role retains 4,096 output tokens.
# Source this file from the workspace root, as shown above. Using the caller's
# physical working directory keeps the contract compatible with Bash and Zsh.
export OPENCODE_TEST_HOME="${AGENT_SDK_STRICT_WORKSPACE}/target/agent-sdk-strict-live/opencode"
export XDG_CONFIG_HOME="${OPENCODE_TEST_HOME}/xdg/config"
export XDG_DATA_HOME="${OPENCODE_TEST_HOME}/xdg/data"
export XDG_CACHE_HOME="${OPENCODE_TEST_HOME}/xdg/cache"
export XDG_STATE_HOME="${OPENCODE_TEST_HOME}/xdg/state"
export OPENCODE_DB="${OPENCODE_TEST_HOME}/database/opencode.db"
export OPENCODE_AUTO_SHARE=false
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false
export OPENCODE_CONFIG_CONTENT='{
  "share": "disabled",
  "enabled_providers": ["ollama"],
  "plugin": [],
  "mcp": {},
  "model": "ollama/gemma4:e4b-it-qat",
  "small_model": "ollama/gemma4:e4b-it-qat",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "ministral-3:8b-instruct-2512-q4_K_M": {
          "name": "ministral-3:8b-instruct-2512-q4_K_M",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "qwen3.5:9b-q4_K_M": {
          "name": "qwen3.5:9b-q4_K_M",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gemma4:e4b-it-qat": {
          "name": "gemma4:e4b-it-qat",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  }
}'
