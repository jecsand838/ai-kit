{
  "schema": "app-sdk.workflow/v2",
  "id": "sleep",
  "revision": "r1",
  "state": {"awake": false},
  "required": ["awake"],
  "reducers": {"awake": "reject_concurrent"},
  "entry": "wait",
  "nodes": [
    {
      "id": "wait",
      "deadline_ms": 1000,
      "step": {"kind": "sleep", "message": "Pause briefly", "delay_ms": 1}
    },
    {
      "id": "awake",
      "step": {
        "kind": "state",
        "mutations": [
          {"kind": "assign", "target": "awake", "value": {"kind": "literal", "value": true}}
        ]
      }
    }
  ],
  "routes": {
    "wait": {"mode": "first", "branches": [{"target": {"kind": "node", "id": "awake"}}]}
  }
}
