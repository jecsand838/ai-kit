{
  "schema": "app-kit.workflow/v2",
  "id": "handoff",
  "revision": "r1",
  "state": {"topic": "Rust ownership", "artifact": null, "review": ""},
  "required": ["topic", "artifact", "review"],
  "reducers": {
    "topic": "reject_concurrent",
    "artifact": "reject_concurrent",
    "review": "reject_concurrent"
  },
  "entry": "write",
  "nodes": [
    {
      "id": "write",
      "step": {
        "kind": "agent",
        "agent": "author",
        "prompt": [
          {"kind": "text", "text": "Return a JSON object with a summary of "},
          {"kind": "state", "path": "topic"}
        ],
        "structured_schema": {
          "type": "object",
          "properties": {"summary": {"type": "string"}},
          "required": ["summary"],
          "additionalProperties": false
        },
        "structured_target": "artifact"
      }
    },
    {
      "id": "review",
      "step": {
        "kind": "agent",
        "agent": "reviewer",
        "prompt": [
          {"kind": "text", "text": "Review this artifact: "},
          {"kind": "state", "path": "artifact"}
        ],
        "text_target": "review"
      }
    }
  ],
  "routes": {
    "write": {
      "mode": "first",
      "branches": [{"target": {"kind": "node", "id": "review"}}]
    }
  }
}
