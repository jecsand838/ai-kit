# Last verified against upstream provider docs: 2026-10-20
# Source this file into your shell before running
# the canonical completion gate:
# `providers-kit/scripts/verify_strict_live.sh`.
# Direct `strict_live` cargo runs are for focused iteration after local
# dependencies such as Ollama are already running.
# The default strict-live gate covers OpenAI, Anthropic, Gemini, and local
# Ollama. Its independent cases are not ignored; use scripts/check.sh for
# deterministic checks rather than an unrestricted cargo test command.
# Batch cases create fresh owned inputs. No pre-provisioned batch file ids
# are required. OpenAI completion polls once per minute for up to 24 hours
# per job. Each Anthropic inline/mixed-row/bounded-results case has a shared
# 24-hour completion deadline, with five-second status polling. Mixed-row proof
# shares its deadline across prerequisite/outcome jobs; setup/results/cleanup
# keep separate bounds. Other Anthropic and Gemini cases keep existing limits. Polling stops on a terminal response.
# Cancellation and cleanup keep separate 11-minute OpenAI / 3-minute other-cloud
# bounds. The default verifier selects the full suite.
# Optional: 0 omits four OpenAI and three Anthropic completion cases, reporting
# PARTIAL coverage with all seven exact names. Cancellation, missing-resource
# and unsupported-input cases remain required.
# Only 0 or 1 is accepted; direct Cargo runs are unaffected by this selector.
# export PROVIDERS_KIT_RUN_LONG_BATCHES=0
# File Search stores remain borrowed and are never modified or deleted.

# OpenAI
export TEST_OPENAI_API_KEY=
export TEST_OPENAI_BASE_URL=https://api.openai.com/v1
export TEST_OPENAI_MODEL_DEFAULT=gpt-6-luna
export TEST_OPENAI_MODEL_EMBEDDINGS=text-embedding-3-small
export TEST_OPENAI_MODEL_INTERACTIVE=gpt-realtime-2.1
# Pre-provisioned read-only File Search store containing
# `ai-kit-provider-strict-file-search-v1`.
export TEST_OPENAI_FILE_SEARCH_STORE_ID=

# Anthropic
export TEST_ANTHROPIC_API_KEY=
export TEST_ANTHROPIC_BASE_URL=https://api.anthropic.com
export TEST_ANTHROPIC_MODEL_DEFAULT=claude-haiku-5-5
export TEST_ANTHROPIC_MODEL_THINKING=claude-haiku-5-5

# Gemini
export TEST_GEMINI_API_KEY=
export TEST_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
export TEST_GEMINI_MODEL_DEFAULT=models/gemini-3.8-flash
# Existing model-specific File Search exception stays on this exact legacy role.
export TEST_GEMINI_MODEL_FILE_SEARCH=models/gemini-2.5-flash
export TEST_GEMINI_MODEL_EMBEDDINGS=models/gemini-embedding-2
export TEST_GEMINI_MODEL_THINKING_LEVEL=models/gemini-3.8-flash
export TEST_GEMINI_SERVICE_TIER=standard
# Pre-provisioned read-only File Search store containing
# `ai-kit-provider-strict-file-search-v1`.
export TEST_GEMINI_FILE_SEARCH_STORE_ID=

# Ollama local
# `verify_strict_live.sh` also checks local Ollama reachability and requires the
# exact models listed below to be installed. The default model must document
# native tool calling and replay support. If the configured local endpoint is
# unreachable, start `ollama serve` before declaring strict-live unavailable.
# Model ids are exact provider ids; the verify path does not append `:latest`.
declare -x TEST_OLLAMA_BASE_URL=http://localhost:11434/api
export TEST_OLLAMA_MODEL_DEFAULT=ministral-3:8b-instruct-2512-q4_K_M
export TEST_OLLAMA_MODEL_REASONING=gpt-oss:20b
export TEST_OLLAMA_MODEL_EMBEDDINGS=qwen3-embedding:8b

# Exact additional local thinking tags required by current-model cases:
# gemma4:e4b-it-qat and qwen3.5:9b-q4_K_M
# Ollama Cloud execution is excluded from this campaign by explicit scope.
